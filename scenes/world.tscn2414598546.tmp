[sub_resource type="TileSet" id="TileSet_4mrxx"]
physics_layer_0/collision_layer = 1
custom_data_layer_0/name = "light_source"
custom_data_layer_0/type = 1
sources/0 = SubResource("TileSetAtlasSource_i7141")

[sub_resource type="GDScript" id="GDScript_4wyf3"]
script/source = "
extends TileMap

@export var light_texture: Texture2D = preload(\"res://art/particles/light.png\")
@export var light_color: Color = Color(1.0, 0.95, 0.8) # warm yellow
@export var light_energy: float = 1.2

func _ready():
	spawn_lights()

func spawn_lights():
	# Assuming layer 0 for the lamp tiles — adjust if your layer index differs
	var layer_id := 0
	var used_cells := get_used_cells(layer_id)

	for cell in used_cells:
		var tile_data := get_cell_tile_data(layer_id, cell)
		if tile_data and tile_data.get_custom_data(\"light_source\") == true:
			# Some environments/type-checkers require calling the constructor callable explicitly
			var light := Light2D.new.call()
			light.texture = light_texture
			light.color = light_color
			light.energy = light_energy
			light.shadow_enabled = true
			# map_to_local expects a Vector2i (cell), not (layer, cell) in this API
			light.position = map_to_local(cell) + Vector2(0, -8)
			add_child(light)
"

